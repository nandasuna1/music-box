{
  "expo": {
    "name": "music-box",
    "slug": "music-box",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vynil-icon.png",
    "scheme": "musicbox",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/378f28e8-6de0-40bd-b2a3-057443343135"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nandasuna.vinyl"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffcc00",
        "foregroundImage": "./assets/images/vynil-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nandasuna.vinyl",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/vynil-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.com.googleusercontent.apps.843337715350-caso2ra8p9j2nvu7k80dmma3f1as0j8s"
        }
      ],
      "expo-secure-store",
      "expo-updates",
      [
        "@sentry/react-native/expo",
        {
          "organization": "nandasuna",
          "project": "music-box"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "378f28e8-6de0-40bd-b2a3-057443343135"
      }
    }
  }
}
